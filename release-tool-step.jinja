      - name: Install the release verifier
        shell: bash
        run: |
          set -euo pipefail
          directory=$(mktemp -d "$RUNNER_TEMP/release-tool.XXXXXXXX")
          curl --fail --silent --show-error --location "https://github.com/chrono-harness/chrono-harness-host-release/releases/download/v{{ host_release_artifact.version }}/chrono-host-release-linux-x86_64" -o "$directory/chrono-host-release"
          (cd "$directory" && echo "{{ host_release_artifact.linux_sha256 }}  chrono-host-release" | sha256sum --check --status)
          chmod 755 "$directory/chrono-host-release"
          echo "$directory" >> "$GITHUB_PATH"
