name: Issue roadmap
on:
  issues:
    types: [opened, reopened, closed, milestoned, demilestoned, deleted, transferred]
  release:
    types: [published]
  workflow_run:
    workflows: [{{ publisher_workflow | to_json }}]
    types: [completed]
  push:
    branches: [{{ dev_branch | to_json }}]
    paths: [.chrono-harness/release.json, .github/roadmap.cjs, .github/workflows/issue-roadmap.yml]
  workflow_dispatch:
permissions:
  contents: read
  issues: write
jobs:
  release-issue:
    if: github.event_name == 'workflow_run'
    permissions:
      contents: read
      issues: write
      actions: read
    concurrency:
      group: release-issue-${{ '{{' }} github.event.workflow_run.id }}
      cancel-in-progress: false
    runs-on: ubuntu-24.04
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1
        with:
          ref: ${{ '{{' }} github.event.repository.default_branch }}
          persist-credentials: false
{% include 'release-tool-step.jinja' %}
      - uses: actions/github-script@3a2844b7e9c422d3c10d287c895573f7108da1b3
        with:
          script: await require('./.github/roadmap.cjs').releaseIssue(github, context)
  reconcile:
    needs: release-issue
    if: always() && (needs.release-issue.result == 'success' || needs.release-issue.result == 'skipped')
    concurrency:
      group: issue-roadmap
      cancel-in-progress: false
    runs-on: ubuntu-24.04
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1
        with:
          ref: ${{ '{{' }} github.event.repository.default_branch }}
          persist-credentials: false
{% include 'release-tool-step.jinja' %}
      - uses: actions/github-script@3a2844b7e9c422d3c10d287c895573f7108da1b3
        with:
          script: |
            const fs = require('node:fs')
            const file = '.chrono-harness/release.json'
            const plan = fs.existsSync(file) ? JSON.parse(fs.readFileSync(file, 'utf8')) : null
            await require('./.github/roadmap.cjs')(github, context, plan)
