{%- import 'tool-catalog.jinja' as tools with context -%}
{%- set selected_tools = tools.selected_tools -%}
{% if tool_install_channels == 'pinned' %}
{{ tools.pins() }}
{% endif %}
{% if 'rust' in selected_tools %}
[tools.rust]
version = "1.95.0"
profile = "minimal"
{% endif %}
{% if 'verus' in selected_tools %}
[tools."http:verus"]
version = "0.2026.04.24.f8e1704"
strip_components = 1
bin_path = "."
[tools."http:verus".platforms]
linux-x64 = { url = "https://github.com/verus-lang/verus/releases/download/release/0.2026.04.24.f8e1704/verus-0.2026.04.24.f8e1704-x86-linux.zip", checksum = "sha256:36b3268ed3a70d948d0d7cb59a5397c54c52e519fc4a644311dadec02d240ce9" }
macos-arm64 = { url = "https://github.com/verus-lang/verus/releases/download/release/0.2026.04.24.f8e1704/verus-0.2026.04.24.f8e1704-arm64-macos.zip", checksum = "sha256:023e0a6e67bb9927f43a8757ebdec318b50cbfe1fec4a1c320c53d5fd71008e7" }
{% endif %}
{% if generate_check %}
[tasks.harness-check]
description = "Run the registered business check"
run = {{ check_command | to_json }}
{% endif %}

{% if local_check_retention or native_check_keep_seconds %}
[tasks.harness-maintain-checks]
{% if native_check_keep_seconds and local_check_retention %}
description = "Maintain native check directories and registered reports"
run = """
native_status=0
chrono-host-bootstrap native-scratch maintain {{ native_check_keep_seconds }} >&2 || native_status=$?
chrono-harness retention --host-root . --request .chrono-harness/maintain-checks.json || exit $?
exit "$native_status"
"""
{% elif native_check_keep_seconds %}
description = "Maintain native check directories"
run = "chrono-host-bootstrap native-scratch maintain {{ native_check_keep_seconds }}"
{% else %}
description = "Maintain registered local check originals"
run = "chrono-harness retention --host-root . --request .chrono-harness/maintain-checks.json"
{% endif %}
{% endif %}
{% if features or generate_check or local_check_retention or native_check_keep_seconds %}
[tasks.harness-setup]
description = "Install this repository's selected tools"
{% set install = 'mise install' if tool_install_channels == 'pinned' else 'sh .chrono-harness/install-tools.sh' %}
{% if local_check_retention %}
run = [
    {{ install | to_json }},
{% if 'instructions' in features %}
    "mise exec -- chrono-instructions sync-rules --host-root .",
{% endif %}
    "sh .chrono-harness/setup-check-retention.sh",
]
{% elif 'instructions' in features %}
run = [{{ install | to_json }}, "mise exec -- chrono-instructions sync-rules --host-root ."]
{% else %}
run = {{ install | to_json }}
{% endif %}
{% endif %}
