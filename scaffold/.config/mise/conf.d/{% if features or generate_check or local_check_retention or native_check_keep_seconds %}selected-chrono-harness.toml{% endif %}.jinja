{%- import 'tool-catalog.jinja' as tools with context -%}
{%- set commands = tools.selected_tools | select('in', tools.catalog) | sort | list -%}
{% if commands -%}
# The checkout supplies the tool names and download locations. Installed data contains versions and SHA-256 only.
[vars]
chrono_selection = '{{ "{{ config_root }}" }}/.chrono-harness/state/tool-selection/versions.toml'
chrono_pins = '{{ "{{ config_root }}" }}/.config/mise/conf.d/chrono-harness.toml'
{% for command in commands -%}
selected_{{ command | replace('-', '_') }} = {{ tools.installed_version | replace('COMMAND', command) | replace('\n', '') | to_json }}
{% endfor %}
{% for command in commands %}
{% set selected = 'vars.selected_' ~ command | replace('-', '_') -%}
{% set pin = 'read_toml(path=vars.chrono_pins)["tools"]["http:' ~ command ~ '"]' -%}
[tools."http:{{ command }}"]
version = {{ tools.effective_version | replace('SELECTED', selected) | replace('PIN', pin) | to_json }}
bin = "{{ command }}"
[tools."http:{{ command }}".platforms]
{% for platform, suffix, index in tools.release_platforms -%}
{% set config = pin ~ '["platforms"]["' ~ platform ~ '"]' -%}
{{ platform }} = { url = {{ tools.selected_url | replace('SELECTED', selected) | replace('PLATFORM', config) | replace('REPOSITORY', tools.catalog[command][0]) | replace('ASSET', command ~ '-' ~ suffix) | to_json }}, checksum = {{ tools.selected_checksum | replace('SELECTED', selected) | replace('PLATFORM', config) | replace('COMMAND', command) | replace('INDEX', index) | replace('\n','') | to_json }} }
{% endfor -%}
{% endfor -%}
{% endif -%}
